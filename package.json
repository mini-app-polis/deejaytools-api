{
  "name": "deejaytools-api",
  "version": "1.1.5",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm --import ./src/instrument.ts --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/node": "^10.75.2",
    "@types/node": "^26.6.2",
    "common-typescript-utils": "^1.2.5",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "flac-tagger": "^2.0.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^181.0.0",
    "hono": "4.13.9",
    "multer": "^2.4.0",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9",
    "postgres": "^3.4.9",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/multer": "^2.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "pnpm": {
    "_comment": [
      "Transitive-only advisories from the SEC-003 audit. Direct dependencies",
      "are bumped in their own package.json instead; these have no declaration",
      "to bump. Each version is the fixed version the advisory names.",
      "xlsx is deliberately absent: no fixed version exists on npm."
    ],
    "overrides": {
      "@babel/core": "^7.29.6",
      "@humanfs/node": "^0.16.8",
      "@opentelemetry/core": "^2.8.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "browserslist": "^4.28.7",
      "esbuild@<0.25.0": "^0.25.0",
      "esbuild@>=0.26.0 <0.28.1": "^0.28.1",
      "form-data": "^4.0.6",
      "handlebars": "^4.7.9",
      "js-yaml@4": "^4.3.1",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "postcss-selector-parser": "^6.1.3",
      "qs": "^6.16.0",
      "shell-quote": "^1.9.0",
      "undici@6": "^6.28.0",
      "vite": "^8.2.2",
      "undici@7": "^7.29.0",
      "ws": "^8.21.0"
    }
  }
}
